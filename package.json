{
  "name": "ldraw-mpd-mcp",
  "version": "0.1.0",
  "description": "Zero-native-dependency MCP server for building, 3D-rendering, visually verifying, and offline-packing LEGO LDraw (.ldr / .mpd) models step-by-step.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ldraw-mpd-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "setup:ldraw": "tsx src/cli.ts setup",
    "doctor": "tsx src/cli.ts doctor",
    "test": "npm run build && node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ldraw",
    "lego",
    "mpd",
    "ldr",
    "cad",
    "3d-rendering",
    "bricklink-studio",
    "ai-agent"
  ],
  "author": "Prama Aditya Putra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PramaAditya/ldraw-mpd-mcp.git"
  },
  "homepage": "https://github.com/PramaAditya/ldraw-mpd-mcp#readme",
  "bugs": {
    "url": "https://github.com/PramaAditya/ldraw-mpd-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
